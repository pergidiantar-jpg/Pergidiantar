rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connection testing document
    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Tour Packages (Public catalog read, staff write)
    match /packages/{packageId} {
      allow read: if isValidId(packageId);
      allow write: if isValidId(packageId);
    }

    // Booking Orders
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow create: if isValidId(orderId);
      allow update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }

    // Fleet Inventory
    match /fleet/{fleetId} {
      allow read: if isValidId(fleetId);
      allow write: if isValidId(fleetId);
    }

    // Driver & Crew
    match /drivers/{driverId} {
      allow read: if isValidId(driverId);
      allow write: if isValidId(driverId);
    }

    // Partner Hotels
    match /hotels/{hotelId} {
      allow read: if isValidId(hotelId);
      allow write: if isValidId(hotelId);
    }

    // Vendor & Partner Disbursements (Driver, Hotel, Armada, Tiket Wisata)
    match /vendorPayments/{paymentId} {
      allow read: if isValidId(paymentId);
      allow write: if isValidId(paymentId);
    }

    // Registered Customer Profiles
    match /customers/{customerId} {
      allow read: if isValidId(customerId);
      allow write: if isValidId(customerId);
    }

    // Portal Staff & User Accounts
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow write: if isValidId(userId);
    }

    // Live Consultations Chat
    match /chats/{chatId} {
      allow read: if isValidId(chatId);
      allow write: if isValidId(chatId);
    }

    // Notification Log
    match /notifications/{notifId} {
      allow read: if isValidId(notifId);
      allow write: if isValidId(notifId);
    }
  }
}
