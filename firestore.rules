rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Connection testing document
    match /test/{testId} {
      allow read, write: if true;
    }

    // Tour Packages (Public catalog read & staff write)
    match /packages/{packageId} {
      allow get: if isValidId(packageId);
      allow list: if true;
      allow write: if isValidId(packageId);
    }

    // Booking Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow write: if isValidId(orderId);
    }

    // Fleet Inventory
    match /fleet/{fleetId} {
      allow get: if isValidId(fleetId);
      allow list: if true;
      allow write: if isValidId(fleetId);
    }

    // Driver & Crew
    match /drivers/{driverId} {
      allow get: if isValidId(driverId);
      allow list: if true;
      allow write: if isValidId(driverId);
    }

    // Partner Hotels
    match /hotels/{hotelId} {
      allow get: if isValidId(hotelId);
      allow list: if true;
      allow write: if isValidId(hotelId);
    }

    // Vendor & Partner Disbursements (Driver, Hotel, Armada, Tiket Wisata)
    match /vendorPayments/{paymentId} {
      allow get: if isValidId(paymentId);
      allow list: if true;
      allow write: if isValidId(paymentId);
    }

    // Registered Customer Profiles
    match /customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if true;
      allow write: if isValidId(customerId);
    }

    // Portal Staff & User Accounts
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow write: if isValidId(userId);
    }

    // Live Consultations Chat
    match /chats/{chatId} {
      allow get: if isValidId(chatId);
      allow list: if true;
      allow write: if isValidId(chatId);
    }

    // Notification Log
    match /notifications/{notifId} {
      allow get: if isValidId(notifId);
      allow list: if true;
      allow write: if isValidId(notifId);
    }

    // Curated & Viral Trip Destinations
    match /trip_destinations/{destId} {
      allow get: if isValidId(destId);
      allow list: if true;
      allow write: if isValidId(destId);
    }

    // Site Visitor Statistics & Real-time Analytics
    match /site_stats/{statId} {
      allow get: if isValidId(statId);
      allow list: if true;
      allow write: if isValidId(statId);
    }

    // Secure Login Audit Logs
    match /login_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if true;
      allow write: if isValidId(logId);
    }
  }
}
